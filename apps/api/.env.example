# Base locale sans Docker : npm run db:local (PGlite, port 5433)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/postgres?connection_limit=1&sslmode=disable"
# Avec Docker : postgresql://flowdesk:flowdesk@localhost:5432/flowdesk

# Redis est optionnel en local : sans REDIS_URL, le cache passe en mémoire.
# REDIS_URL="redis://localhost:6379"

JWT_ACCESS_SECRET="dev-access-secret-a-changer"
JWT_REFRESH_SECRET="dev-refresh-secret-a-changer"
WEB_ORIGIN="http://localhost:3000"
PORT=4000
